{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-cut.local/schemas/paper-edit.schema.json",
  "title": "claude-cut/paper-edit@1: beats and cues (written by the paper-edit skill)",
  "description": "Beats are defined by sentence numbers from script.json; the LLM never copies spoken text.",
  "type": "object",
  "required": [
    "schema",
    "created",
    "inputs",
    "title",
    "sections",
    "beats"
  ],
  "properties": {
    "schema": {
      "const": "claude-cut/paper-edit@1"
    },
    "created": {
      "$ref": "_defs.schema.json#/$defs/created"
    },
    "inputs": {
      "type": "object",
      "required": [
        "script"
      ],
      "properties": {
        "script": {
          "$ref": "_defs.schema.json#/$defs/inputRef"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "type": "string"
    },
    "notes": {
      "type": "object",
      "properties": {
        "before_timeline": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "blur_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sec\\d{2,3}$"
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "section",
          "sentences",
          "visual",
          "cues"
        ],
        "properties": {
          "id": {
            "$ref": "_defs.schema.json#/$defs/beatId"
          },
          "section": {
            "type": "string",
            "pattern": "^sec\\d{2,3}$"
          },
          "sentences": {
            "$ref": "_defs.schema.json#/$defs/sentenceRange"
          },
          "chapter": {
            "type": "string",
            "minLength": 1,
            "description": "A chapter (YouTube chapter marker) starts at this beat, with this title. It runs until the next beat that sets one."
          },
          "visual": {
            "type": "string"
          },
          "transition_in": {
            "type": "string"
          },
          "pace": {
            "type": "string"
          },
          "est_seconds": {
            "type": "number",
            "minimum": 0
          },
          "key_point": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "cues": {
            "type": "array",
            "items": {
              "$ref": "_defs.schema.json#/$defs/cue"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
