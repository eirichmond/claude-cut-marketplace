{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-cut.local/schemas/script.schema.json",
  "title": "claude-cut/script@1: numbered sentences (written by number_sentences.py)",
  "type": "object",
  "required": ["schema", "created", "inputs", "title", "sections", "sentences", "script_cues"],
  "properties": {
    "schema": {"const": "claude-cut/script@1"},
    "created": {"$ref": "_defs.schema.json#/$defs/created"},
    "inputs": {
      "type": "object", "required": ["script"],
      "properties": {"script": {"$ref": "_defs.schema.json#/$defs/inputRef"}},
      "additionalProperties": false
    },
    "title": {"type": "string"},
    "preamble": {"type": "array", "items": {"type": "string"}},
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title", "level", "first", "last"],
        "properties": {
          "id": {"type": "string", "pattern": "^sec\\d{2,3}$"},
          "title": {"type": "string"},
          "level": {"type": "integer", "minimum": 1, "maximum": 6},
          "first": {"type": ["integer", "null"]},
          "last": {"type": ["integer", "null"]}
        },
        "additionalProperties": false
      }
    },
    "sentences": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["n", "section", "para", "text"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "section": {"type": "string"},
          "para": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "script_cues": {
      "type": "array",
      "items": {
        "type": "object", "required": ["after", "section", "kind", "text"],
        "properties": {
          "after": {"type": "integer", "minimum": 0},
          "section": {"type": ["string", "null"]},
          "kind": {"enum": ["bracket", "code"]},
          "text": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
